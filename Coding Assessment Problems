import csv

def fixed_width_parser(file_path, spec, output_csv):
    with open( file_path, 'r') as fixedWithFile, open(output_csv, 'w', newline = '') as newFile:
        writer = csv.writer(newFile)

        for line in fixedWithFile:
            start = 0
            row = []
            for width in spec:
                row.append ( line[start:start + width].strip())
                start += width
            writer.writerow(row)


specification = [5, 12, 3, 2, 13, 7, 10, 13, 20, 13]
fixed_width_parser("fixed_width.txt", specification, "output_file.txt")


